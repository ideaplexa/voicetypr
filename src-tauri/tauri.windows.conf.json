{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/stage-windows-pdb.cjs"
  },
  "bundle": {
    "resources": [
      "windows/resources/vc_redist.x64.exe",
      "windows/resources/VulkanRT-Installer.exe",
      "windows/resources/voicetypr.pdb",
      "../sidecar/crispasr/dist/CrispASR-LICENSE",
      "../sidecar/crispasr/dist/ggml-LICENSE"
    ],
    "externalBin": [
      "../sidecar/whisper-vulkan/dist/whisper-vulkan-sidecar",
      "../sidecar/crispasr/dist/crispasr-sidecar-cpu",
      "../sidecar/crispasr/dist/crispasr-sidecar-gpu"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
