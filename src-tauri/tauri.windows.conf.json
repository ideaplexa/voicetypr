{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/stage-windows-pdb.cjs && node scripts/stage-windows-ort.cjs"
  },
  "bundle": {
    "resources": [
      "windows/resources/vcredist/*.dll",
      "windows/resources/voicetypr.pdb",
      "models/silero/LICENSE",
      "models/onnxruntime/LICENSE",
      "models/onnxruntime/ThirdPartyNotices.txt",
      "models/onnxruntime/ort-LICENSE-MIT",
      "models/onnxruntime/README.txt",
      "models/onnxruntime/provenance.json"
    ],
    "externalBin": [
      "../sidecar/whisper-vulkan/dist/whisper-vulkan-sidecar"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
