{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voicetypr",
  "identifier": "com.ideaplexa.voicetypr",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Voicetypr",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 12, "y": 12 },
        "label": "main",
        "width": 1000,
        "height": 680,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "minimizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: https://voicetypr.com https://api.voicetypr.com https://github.com asset:",
        "media-src": "'self' asset:"
      }
    }
  },
  "bundle": {
    "publisher": "Ideaplexa LLC",
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ideaplexa/voicetypr/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2Q0M5NTZENjAwM0YyNDkKUldSSjhnTmdiWlhNRm0wdHQ1YmxNSzBWS2tiZlcyZ3FJZG5FajZ3MFBzTUZmRDgvZys5R1J6c2cK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
