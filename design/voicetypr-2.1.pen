          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "LnGNB",
              "name": "Title",
              "fill": "#18181A",
              "content": "C — Morphing Island",
              "fontFamily": "Geist",
              "fontSize": 24,
              "fontWeight": "600",
              "letterSpacing": -0.4
            },
            {
              "type": "text",
              "id": "X7ySy",
              "name": "Concept",
              "fill": "#6A6A66",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "One living shape that never swaps — it morphs: dot → capsule → wide card → back. Like Dynamic Island, every change is a spring you can interrupt, so back-to-back dictation feels fluid.",
              "fontFamily": "Geist",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "BZ1Aa",
              "name": "Motion",
              "fill": "#3F7D5C",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Motion — all size/shape changes on one interruptible spring (bounce ≈0.25, response ≈0.45 s) · bars grow out of the dot · working: a sage progress arc spins inside the capsule · done: the arc closes into a check, then the shape collapses to the dot",
              "fontFamily": "Geist",
              "fontSize": 12.5,
              "fontWeight": "normal"
            }
          ]
        },
