      "width": 1500,
      "fill": "#0E0F11",
      "cornerRadius": 18,
      "layout": "vertical",
      "gap": 26,
      "padding": 40,
      "children": [
        {
          "type": "frame",
          "id": "UktWb",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "LEljJ",
              "name": "Eyebrow",
              "fill": "#8FD1A8",
              "content": "CHOSEN DIRECTION · BETA.4",
              "fontFamily": "Geist Mono",
              "fontSize": 11,
              "fontWeight": "600",
              "letterSpacing": 1.2
            },
            {
              "type": "text",
              "id": "cz2gw",
              "name": "Title",
              "fill": "#F4F4F1",
              "content": "Morphing Island — one living shape that knows where your words are going",
              "fontFamily": "Geist",
              "fontSize": 26,
              "fontWeight": "600",
              "letterSpacing": -0.5
            },
            {
              "type": "text",
              "id": "qBS3U",
              "name": "Concept",
              "fill": "#A3A3A0",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "It opens for a moment when you press the key to confirm the app, Polish style, mic and engine, then shrinks to a compact island while you talk. Every change is one interruptible spring — dot, island, card and back — so it never jumps.",
              "lineHeight": 1.45,
              "fontFamily": "Geist",
              "fontSize": 14,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "YNMsn",
              "name": "Motion",
              "fill": "#8FD1A8",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "spring bounce 0.2 · response 0.42 s · start card holds 1.2 s then collapses · level attack 30 ms / release 180 ms, peak holds 300 ms · hover opens the controls · reduced motion: cross-fade only",
              "fontFamily": "Geist Mono",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "ryNAn",
          "name": "Row",
          "width": "fill_container",
          "gap": 16,
          "children": [
            {
              "type": "frame",
              "id": "YmGqg",
              "name": "State Ready",
              "width": "fill_container",
              "layout": "vertical",
